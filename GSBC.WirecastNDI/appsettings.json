{
  "WirecastNdi": {
    "Ndi": {
      "SourceName": "Wirecast Program",
      "Groups": "",
      "SendBlackWhenIdle": true
    },
    "Video": {
      "Width": 1920,
      "Height": 1080,
      "FrameRate": "30"
    },
    "Audio": {
      "Enabled": true,
      "SampleRate": 48000,
      "Channels": 2,
      "DelayMs": 0
    },
    "Capture": {
      "FfmpegPath": "ffmpeg",
      "VideoDevice": "Wirecast Virtual Camera",
      "AudioDevice": "Wirecast Virtual Microphone",
      "InputOptions": "",
      "AudioBufferMs": 40,
      "RestartDelaySeconds": 5,
      "StallTimeoutSeconds": 10,
      "StatsIntervalSeconds": 300
    }
  },
  "Logging": {
    "Directory": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
